#!/usr/bin/env bash
set -euo pipefail

# Example: sync local secrets from SSOT machine to second machine over SSH.
# Copy to scripts/sync-secrets-to-second.sh and customize values.

SECOND_HOST="${SECOND_HOST:-user@second-host}"
TARGET_DIR="${TARGET_DIR:-~/.pi/agent}"

rsync -avz -e ssh \
  "${HOME}/.pi/agent/.env" \
  "${SECOND_HOST}:${TARGET_DIR}/.env"

echo "Secret sync complete to ${SECOND_HOST}:${TARGET_DIR}/.env"
